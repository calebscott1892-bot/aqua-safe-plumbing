# Enquiry form → Resend. Set these in Vercel (Project → Settings →
# Environment Variables). Never commit real values.

# Required — your Resend API key. Create it at resend.com → API Keys.
# Server-only secret; do NOT prefix with NEXT_PUBLIC.
RESEND_API_KEY=

# Optional — where enquiries are delivered. Defaults to info@aquasafeplumbing.com.
# ENQUIRY_TO=info@aquasafeplumbing.com

# Optional — the "from" address. Must be on a Resend-verified domain
# (verify aquasafeplumbing.com.au in Resend → Domains first).
# ENQUIRY_FROM=Aqua-Safe Website <enquiries@aquasafeplumbing.com.au>
